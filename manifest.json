{
  "manifest_version": 3,
  "name": "Stretchtext",
  "version": "1.0.0",
  "description": "Turn any web page into stretchtext: click a phrase to grow it where it stands, click again to shrink it back. Readers pay with their own Pollen.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": [
    "https://gen.pollinations.ai/*",
    "https://enter.pollinations.ai/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/sentences.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Stretchtext",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
